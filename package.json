{
  "name": "turborepo-poc",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset add",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish",
    "install-dependencies": "export RELEASE_ENV=development && node scripts/pre-install.js && pnpm install",
    "install-dependencies:prod": "export RELEASE_ENV=production && node scripts/pre-install.js && pnpm install",
    "preinstall": "node scripts/select-package-version.js",
    "install:dev": "export NODE_ENV=development && pnpm install",
    "install:prod": "export NODE_ENV=production && pnpm install",
    "setup-github-auth": "node scripts/setup-github-auth.js",
    "build:dev": "NODE_ENV=development pnpm install && pnpm run build",
    "build:prod": "NODE_ENV=production pnpm install && pnpm run build"

  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "prettier": "^3.6.2",
    "turbo": "^2.5.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
